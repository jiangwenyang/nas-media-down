# 必填：访问密码（未设置时容器会拒绝启动）
ACCESS_PASSWORD=change-me

# 文件属主：群晖常用 1026:100，可通过 `id 用户名` 查询
PUID=1026
PGID=100

# 时区与端口
TZ=Asia/Shanghai
PORT=8080

# 同时下载的视频数量（含同一播放列表内的并行）
MAX_CONCURRENT=2
MAX_PLAYLIST_ITEMS=500

# 合并容器优先级：mp4/mkv 表示能 mp4 就 mp4，否则无损 mkv
MERGE_FORMAT=mp4/mkv

# NAS 上的映射路径
DOWNLOAD_PATH=./downloads
DATA_PATH=./data

# 可选：HTTPS 反向代理时开启
# COOKIE_SECURE=true

# 可选：需要登录/人机验证的站点，挂载 cookies.txt 后设置容器内路径
# COOKIES_FILE=/data/cookies.txt
# COOKIES_PATH=./cookies.txt

# 可选：NAS 需要代理访问外网时设置
# HTTP_PROXY=http://192.168.1.2:7890
# HTTPS_PROXY=http://192.168.1.2:7890
